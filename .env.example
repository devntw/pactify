# Copy this file to .env and fill real values before docker compose up

# Twilio media download auth for WhatsApp voice notes (required for MediaUrl0 fetch)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio WhatsApp sender (sandbox usually whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Public base URL for Layer1 webhook (e.g. ngrok HTTPS URL) so Twilio can fetch PDF media.
PUBLIC_BASE_URL=

# Layer 2 LLM (LM Studio on Mac host)
OPENAI_BASE_URL=http://host.docker.internal:1234/v1
OPENAI_API_KEY=lm-studio
# Must match model id shown in LM Studio
OPENAI_MODEL=local-model
# Set false if your local server errors on json_object response_format
LLM_JSON_RESPONSE_FORMAT=false

# Optional image tags
LAYER1_IMAGE=gawah-layer1:v1
LAYER2_IMAGE=gawah-layer2:v1
LAYER3_IMAGE=gawah-layer3:v1
LAYER4_IMAGE=gawah-layer4:v1
LAYER5_IMAGE=gawah-layer5:v1

# Optional Layer 3 forwarding override
LAYER3_URL=http://layer3:8002/ingest
LAYER3_TIMEOUT_SECONDS=10

# Layer 3 -> Layer 4 proof generation
LAYER4_URL=http://layer4:8003/generate-proof
LAYER4_TIMEOUT_SECONDS=10

# Layer 4 -> Layer 5 execution registration
LAYER5_URL=http://layer5:8004/register_contract
LAYER5_TIMEOUT_SECONDS=10